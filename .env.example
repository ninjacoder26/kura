# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Supabase service role (SERVER-ONLY — keep secret!).
# Needed ONLY for the admin tag-sweep in Settings > Admin Tools.
# Vercel: Environment Variables > SUPABASE_SERVICE_ROLE_KEY, then redeploy.
# Supabase dashboard: Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public URL (REQUIRED in production, e.g. Vercel).
# All auth redirects and domain checks use this so login never hops
# between deployments (which splits sessions/cookies). Leave unset for
# local development.
NEXT_PUBLIC_SITE_URL=https://kurasocial.vercel.app

# Cloudinary (unsigned uploads for post images, avatars, banners).
# Create an unsigned upload preset in the Cloudinary dashboard
# (Settings > Upload > Upload presets) and set the names below.
# If unset, the app falls back to Supabase Storage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=kura_unsigned

# Groq AI post-tagger (SERVER-ONLY — never add NEXT_PUBLIC_ prefix).
# Get a free key at https://console.groq.com (API Keys page).
# - Local dev: paste it into your gitignored .env file.
# - Vercel: Project > Settings > Environment Variables > GROQ_API_KEY,
#   then redeploy. Free-tier model used: llama-3.1-8b-instant.
# Without it, new posts fall back to local keyword tags (app keeps working).
GROQ_API_KEY=
