# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: For server-side admin operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary (unsigned uploads for post images, avatars, banners).
# Create an unsigned upload preset in the Cloudinary dashboard
# (Settings > Upload > Upload presets) and set the names below.
# If unset, the app falls back to Supabase Storage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=kura_unsigned
